###########################################################################################
#
# Main -> MQBCoding -> Customization -> CarPlay Route Guidance - New
#
###########################################################################################
screen "CarPlay Route Guidance - New" Customization

keyValue
    value   String sys 0x00000000 0
    label   "Latest luka-dev supervisor-based CarPlay RGI deployment."
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "OLD installs are restored to stock before migration to NEW."
    poll    0

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/install_carplay_rgi_new.sh"
   label   "Install/Update CarPlay Route Guidance - New"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/uninstall_carplay_rgi_new.sh"
   label   "Restore/Uninstall CarPlay Route Guidance - New"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/collect_carplay_rgi_new_logs.sh"
   label   "Copy CarPlay RGI New runtime logs to SD-card"
